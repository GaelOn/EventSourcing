<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageId>EventSourcing.Compatibility</PackageId>
    <Version>0.1.0-alpha.5</Version>
    <RepositoryUrl>https://github.com/GaelOn/EventSourcing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Family Horizon</Authors>
    <Description>Legacy synchronous reversible callback aggregates for EventSourcing.</Description>
    <PackageTags>event-sourcing;compatibility</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EventSourcing/EventSourcing.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
